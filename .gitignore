# Atech Atelier: public repository ignore rules.

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Build output: branding/build_appimage.sh writes here
dist/
out/
*.AppImage
*.AppImage.zsync
*.AppImage.sha256
SHA256SUMS

# Reference model, regenerated by the build from cockpit/fixtures/crane/
cockpit/fixtures/crane/build/
cockpit/fixtures/crane/build.log

# FreeCAD backups and lock files
*.FCBak
*.FCStd.*-*

# Secrets. Never commit an API key.
.env
.env.*
!.env.example
*.secret
secrets.*
credentials*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.gpg
.netrc
.npmrc
.pypirc

# Local tool and agent config (may hold tokens or private paths)
.mcp.json
*.local.json
.claude/
.cursor/

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Logs, agent chat workspaces, eval runs
*.log
chat-*/
addon/AcadAgent/tests/eval/runs/
