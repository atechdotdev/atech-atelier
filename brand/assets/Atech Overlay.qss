/*
 * Atech Atelier — overlay panel sheet (Tasks, Report, ... over the 3D view).
 *
 * GENERATED by brand/tools/build_qss.py (brand/tools/qss.py). DO NOT EDIT.
 * Selected by MainWindow/OverlayActiveStyleSheet, seeded by
 * branding/assets/atech_user_template.cfg. Derived from FreeCAD 1.1.3's
 * Gui/Stylesheets/overlay/Freecad Overlay.qss (LGPL-2.1-or-later).
 *
 * Colours are theme tokens, resolved by FreeCAD against the active
 * "Atech Atelier Light/Dark" parameters, so one file serves both modes.
 */

Gui--DockWnd--ReportOutput,
Gui--TaskView--TaskView QScrollArea {
    border: none;
}

QTabWidget::pane {
    background-color: transparent;
    border: transparent;
}

QAbstractItemView {
    alternate-background-color: @PrimaryColor;
    color: @TextForegroundColor;
    border: 1px solid @GeneralBorderColor;
}

/* The panel's own title bar: brand panel surface, secondary text. */
Gui--OverlayTitleBar,
Gui--OverlaySplitterHandle {
    background-color: @AtechPanelColor;
    color: @AtechMutedColor;
}

/* FreeCAD 1.1.3 gives a dock inside an overlay panel its OWN title bar as
   well (MEASURED on the stock AppImage too: "Tasks" twice, one centred, one
   right-aligned). The panel's bar already names the dock and carries the
   panel controls, so the dock's caption is drawn in no colour; its two
   buttons (Overlay, Float) stay usable. OverlayTitleBar::paintEvent draws
   the caption with the widget's own pen, which "color" sets. */
Gui--OverlayTabWidget QDockWidget > Gui--OverlayTitleBar {
    color: transparent;
}

/* The Tasks panel's ground. Only painted when the panel is NOT in FreeCAD's
   transparent mode: in that mode OverlayTabWidget::_setOverlayMode sets
   WA_NoSystemBackground on every child, which suppresses any stylesheet
   background (MEASURED: this rule then changes no pixel), and the 3D view
   shows through the gaps between task boxes, including its corner axis
   labels ("stray x", R88). The template therefore seeds the right-hand
   panel opaque (DockWindows/OverlayRight/Transparent = 0); the eye button
   in the title bar still turns transparency back on. */
Gui--OverlayTabWidget Gui--TaskView--TaskPanel {
    background-color: @BackgroundColor;
}

/* Overwrites Properties panel to use the theme text. */
Gui--TreePanel QTreeView {
    background-color: @PrimaryColor;
    border: 0px solid @TextForegroundColor;
    color: @TextForegroundColor;
    gridline-color: @GeneralGridLinesColor;
    border-radius: 0px;
}

Gui--TreePanel QTreeView::item {
    color: @TextForegroundColor;
}

Gui--TreePanel QTreeView::item:disabled {
    color: @TextDisabledColor;
}

Gui--TreePanel QTreeView:disabled {
    color: @TextDisabledColor;
}

Gui--PropertyEditor--PropertyEditor {
    qproperty-itemBackground: @TextEditFieldBackgroundColor;
}

Gui--OverlayTabWidget Gui--TreePanel QTreeView::item {
    color: @TextForegroundColor;
}

Gui--OverlayTabWidget Gui--TreePanel QTreeView::item:disabled {
    color: @TextDisabledColor;
}

Gui--OverlayTabWidget {
    qproperty-effectColor: @3DViewBackgroundRefColor;
    qproperty-effectBlurRadius: 0;
    qproperty-effectOffsetX: 0;
    qproperty-effectOffsetY: 0;
    qproperty-effectWidth: 1;
    qproperty-effectHeight: 1;
    qproperty-enableEffect: 1;
}

Gui--OverlayTabWidget#OverlayBottom {
    qproperty-effectColor: @3DViewBackgroundRefColor;
    qproperty-effectBlurRadius: 0;
    qproperty-effectOffsetX: 0.0;
    qproperty-effectOffsetY: 0.0;
    qproperty-effectWidth: 1;
    qproperty-effectHeight: 1;
    qproperty-enableEffect: 1;
}

Gui--OverlayTabWidget::pane {
    background-color: transparent;
    border: transparent;
}

QSint--ActionGroup QFrame[class="content"] {
    border-bottom: 1px solid @GeneralBorderColor;
    border-left: 1px solid @GeneralBorderColor;
    border-right: 1px solid @GeneralBorderColor;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

QSint--ActionGroup QFrame[class="header"] {
    border: 1px solid @GeneralBorderColor;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

Gui--OverlayTabWidget::tab-bar:top,
Gui--OverlayTabWidget::tab-bar:bottom {
    left: 10px;
    alignment: left;
}

Gui--OverlayTabWidget::tab-bar:left,
Gui--OverlayTabWidget::tab-bar:right {
    top: 10px;
    alignment: top;
}

/* Upstream also set "background-color: red" here. OverlayProxyWidget
   paints itself (only the hint), so that rule never drew; dropped. */
Gui--OverlayProxyWidget {
    qproperty-hintColor: rgba(250, 250, 250, 0.6);
}

/* Title-bar controls, matching the application sheet's tool buttons:
   no padding (the button is a fixed 17 px square, so any padding shrinks
   the icon), hover = raised plane, checked = accent OUTLINE on a raised
   plane. Upstream filled checked with @ThemeAccentColor1 (R88). */
Gui--OverlayToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 0px;
}

Gui--OverlayToolButton:hover {
    background-color: @AtechHoverColor;
    border: 1px solid @GeneralBorderColor;
}

Gui--OverlayToolButton:pressed,
Gui--OverlayToolButton:checked {
    background-color: @AtechHoverColor;
    border: 1px solid @AccentColor;
}

Gui--OverlayToolButton:checked:hover {
    border: 1px solid @AccentColor;
    background-color: @PrimaryColorLighten2;
}

/* Resting icons: upstream's lightgray (#888) is a 136-luma glyph on the
   dark panel, the "low-contrast dock buttons" of R118, so the resting colour
   is the Atech token AtechOverlayIconColor (lightgray in light, white in
   dark). The dock's own Float button had no rule here at all and kept its
   built-in black glyph (MEASURED max luma 0 on dark). */
Gui--OverlayToolButton[objectName="OBTN Transparent"] {
    image: url(qss:@IconsLocationFolderName/transparent-@AtechOverlayIconColor.svg);
}

Gui--OverlayToolButton[objectName="OBTN Transparent"]:hover {
    image: url(qss:@IconsLocationFolderName/transparent-@StylesheetIconsColor.svg);
}

Gui--OverlayToolButton[objectName="OBTN Overlay"] {
    image: url(qss:@IconsLocationFolderName/overlay-@AtechOverlayIconColor.svg);
}

Gui--OverlayToolButton[objectName="OBTN Overlay"]:hover {
    image: url(qss:@IconsLocationFolderName/overlay-@StylesheetIconsColor.svg);
}

Gui--OverlayToolButton[objectName="OBTN AutoMode"] {
    image: url(qss:@IconsLocationFolderName/mode-@AtechOverlayIconColor.svg);
}

Gui--OverlayToolButton[objectName="OBTN AutoMode"]:hover {
    image: url(qss:@IconsLocationFolderName/mode-@StylesheetIconsColor.svg);
}

Gui--OverlayToolButton[objectName="OBTN Float"] {
    image: url(qss:@IconsLocationFolderName/float-@AtechOverlayIconColor.svg);
}

Gui--OverlayToolButton[objectName="OBTN Float"]:hover {
    image: url(qss:@IconsLocationFolderName/float-@StylesheetIconsColor.svg);
}

/* The task dialog's Close button: Qt's stock icon is a black X, invisible
   on the dark theme (R118). Same rule as the application sheet, repeated
   because this sheet is the one set on the panel. */
QDialogButtonBox {
    dialog-close-icon: url(qss:@IconsLocationFolderName/close-@StylesheetIconsColor.svg);
}
