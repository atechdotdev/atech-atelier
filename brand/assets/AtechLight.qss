/*
 * Atech Atelier — light theme.
 *
 * GENERATED by brand/tools/build_qss.py from brand/tokens.py.
 * DO NOT EDIT: the next build overwrites it. Change brand/tokens.py.
 *
 * Applied via the MainWindow/StyleSheet preference, seeded by
 * branding/assets/atech_user_template.cfg on first run. The dock-scoped
 * sheet in addon/AcadAgent/acadagent/theme.py remains the fallback for a
 * stock FreeCAD.
 *
 * Palette for this mode, ported from the atech.dev frontend:
 *
 *   base    #f5f5f5   window / dock background
 *   panel   #ffffff   raised surface
 *   sunken  #f9fafb   input wells
 *   line    #e5e7eb   borders
 *   text    #111827   primary text
 *   muted   #6b7280   secondary text
 *   dim     #9ca3af   tertiary text
 *   accent  #07805e   focus and active tool
 *   ok      #387e4f   pass
 *   fail    #cc3d28   fail  (louder than pass — CLAUDE.md R5)
 */

/* ---------------------------------------------------------------- shell */
QMainWindow,
QDockWidget,
QDialog {
    background: #f5f5f5;
    color: #111827;
}

QWidget {
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
}

QMenuBar {
    background: #ffffff;
    color: #111827;
    border-bottom: 1px solid #e5e7eb;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
}

QMenuBar::item:selected {
    background: #f3f4f6;
    color: #111827;
}

QMenu {
    background: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
    padding: 4px;
}

QMenu::item:selected {
    background: #f3f4f6;
}

QMenu::separator {
    height: 1px;
    background: #e5e7eb;
    margin: 4px 8px;
}

/* -------------------------------------------------------------- toolbar */
QToolBar {
    background: #f5f5f5;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    spacing: 2px;
    padding: 3px;
}

QToolButton {
    background: transparent;
    color: #111827;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px;
}

QToolButton:hover {
    background: #f3f4f6;
    border-color: #e5e7eb;
}

QToolButton:checked,
QToolButton:pressed {
    background: #f3f4f6;
    border-color: #07805e;
    color: #07805e;
}

/* Dropdown tool buttons (Undo/Redo history, view menus, Part primitives).
   Once QToolButton carries a border, Qt's stylesheet style draws the
   ::menu-button sub-control itself, and with no rule for it the result was
   a solid black bar beside every dropdown (release PRD R51, dogfood D15).
   The arrow images are upstream's own, reached through the "qss:" search
   path FreeCAD registers for Gui/Stylesheets (StartupProcess.cpp). */
QToolButton[popupMode="1"] {
    padding-right: 14px;
}

QToolButton::menu-button {
    background: transparent;
    border: 1px solid transparent;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    width: 12px;
}

QToolButton::menu-button:hover {
    background: #f3f4f6;
    border-left-color: #e5e7eb;
}

QToolButton::menu-button:pressed {
    background: #f3f4f6;
}

QToolButton::menu-arrow,
QToolButton::menu-indicator {
    image: url(qss:images_classic/arrow-down-darkgray.svg);
    width: 8px;
    height: 8px;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
}

/* ---------------------------------------------------------------- docks */
QDockWidget::title {
    background: #ffffff;
    color: #6b7280;
    font-family: 'Sen', 'Inter', system-ui, sans-serif;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 6px 10px;
    border-bottom: 1px solid #e5e7eb;
}

/* ------------------------------------------------------- tree and lists */
QTreeView,
QListView,
QTableView {
    background: #ffffff;
    alternate-background-color: #f9fafb;
    color: #111827;
    border: 1px solid #e5e7eb;
    selection-background-color: #f3f4f6;
    selection-color: #111827;
    outline: none;
}

QHeaderView::section {
    background: #f9fafb;
    color: #6b7280;
    border: none;
    border-right: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
    padding: 5px 8px;
}

/* ----------------------------------------------------------------- tabs */
QTabWidget::pane {
    border: 1px solid #e5e7eb;
    background: #ffffff;
}

QTabBar::tab {
    background: #f5f5f5;
    color: #6b7280;
    border: 1px solid #e5e7eb;
    border-bottom: none;
    padding: 6px 14px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #111827;
    border-top: 2px solid #07805e;
}

/* --------------------------------------------------------------- inputs */
QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
Gui--QuantitySpinBox,
Gui--IntSpinBox,
QComboBox {
    background: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-radius: 5px;
    padding: 5px 8px;
    selection-background-color: #07805e;
    selection-color: #ffffff;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
Gui--QuantitySpinBox:focus,
Gui--IntSpinBox:focus,
QComboBox:focus {
    border-color: #07805e;
}

/* Spin boxes, FreeCAD's unit-aware ones included (every number in a task
   panel is a Gui::QuantitySpinBox). Once the box carries a border, Qt's
   stylesheet style draws the step buttons itself, and with no rule for them
   they rendered as blank dark slots with no arrows (R88 GUI pass). Arrow
   images are upstream's, as for the tool-button menus above. */
QSpinBox,
QDoubleSpinBox,
Gui--QuantitySpinBox,
Gui--IntSpinBox {
    padding: 3px 18px 3px 8px;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
Gui--QuantitySpinBox::up-button,
Gui--IntSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button,
Gui--QuantitySpinBox::down-button,
Gui--IntSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    background: transparent;
    border: none;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
Gui--QuantitySpinBox::up-button,
Gui--IntSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button,
Gui--QuantitySpinBox::down-button,
Gui--IntSpinBox::down-button {
    subcontrol-position: bottom right;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
Gui--QuantitySpinBox::up-button:hover,
Gui--IntSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover,
Gui--QuantitySpinBox::down-button:hover,
Gui--IntSpinBox::down-button:hover {
    background: #f3f4f6;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
Gui--QuantitySpinBox::up-arrow,
Gui--IntSpinBox::up-arrow {
    image: url(qss:images_classic/arrow-up-darkgray.svg);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
Gui--QuantitySpinBox::down-arrow,
Gui--IntSpinBox::down-arrow {
    image: url(qss:images_classic/arrow-down-darkgray.svg);
    width: 8px;
    height: 8px;
}

/* Measurements are mono. Every number this app prints is a measured
   dimension, so the face is load-bearing, not decorative. */
QPlainTextEdit,
QTextEdit {
    font-family: 'Geist Mono', 'DejaVu Sans Mono', monospace;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
    selection-background-color: #f3f4f6;
}

/* -------------------------------------------------------------- buttons */
QPushButton {
    background: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 5px;
    padding: 6px 14px;
}

QPushButton:hover {
    background: #f3f4f6;
}

QPushButton:pressed {
    background: #f9fafb;
}

QPushButton:default {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
}

QPushButton:default:hover {
    background: #1a1a1a;
}

QPushButton:disabled {
    color: #9ca3af;
    border-color: #e5e7eb;
    background: #f5f5f5;
}

/* ------------------------------------------------------------ statusbar */
QStatusBar {
    background: #ffffff;
    color: #6b7280;
    border-top: 1px solid #e5e7eb;
}

QStatusBar::item {
    border: none;
}

/* ----------------------------------------------------------- scrollbars */
QScrollBar:vertical {
    background: #f5f5f5;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #d1d5db;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #9ca3af;
}

QScrollBar:horizontal {
    background: #f5f5f5;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #d1d5db;
    border-radius: 6px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #9ca3af;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    border: none;
    height: 0;
    width: 0;
}

/* ------------------------------------------------------------- splitter */
QSplitter::handle {
    background: #e5e7eb;
}

/* -------------------------------------------------------------- tooltip */
QToolTip {
    background: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    padding: 4px 7px;
}

/* ----------------------------------------------------------- task panel */
/* The boxes in the Tasks panel (QSint ActionGroup). Unstyled, they paint
   from Qt's default palette, which this sheet does not set: in the dark
   theme that was a light box with the white header text on it, unreadable
   (MEASURED in the R88 GUI pass, Part_Primitives). Only the surfaces and
   the text ON them are set here; everything inside keeps its own rules. */

/* The box itself (Gui::TaskView::TaskBox) fills its background from the
   same default palette, and only its rounded header and content corners
   let it through: 1-2 near-white pixels (MEASURED 221 and 230) at each
   dark header's top corners (release PRD R118). Transparent lets the
   panel's own ground show there instead. */
QSint--ActionGroup {
    background: transparent;
}

QSint--ActionGroup QFrame[class="header"] {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QSint--ActionGroup QToolButton[class="header"] {
    background: transparent;
    color: #111827;
    border: none;
    font-weight: 600;
    text-align: left;
}

QSint--ActionGroup QFrame[class="content"] {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-top: none;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

QSint--ActionGroup QFrame[class="content"] QLabel,
QSint--ActionGroup QFrame[class="content"] QGroupBox,
QSint--ActionGroup QFrame[class="content"] QCheckBox,
QSint--ActionGroup QFrame[class="content"] QRadioButton {
    color: #111827;
}

QSint--ActionGroup QFrame[class="content"] QLabel:disabled,
QSint--ActionGroup QFrame[class="content"] QGroupBox:disabled,
QSint--ActionGroup QFrame[class="content"] QCheckBox:disabled,
QSint--ActionGroup QFrame[class="content"] QRadioButton:disabled {
    color: #9ca3af;
}

/* The 1 px QFrame QSint puts between a box's header and its content paints
   in Qt's default mid grey (MEASURED 159,159,159 in both modes, a bright
   rule across every dark task box). The header's own border already closes
   the box; hidden as upstream FreeCAD.qss does. */
QSint--ActionGroup QFrame[class="separator"] {
    min-height: 0;
    max-height: 0;
    border: none;
}

/* -------------------------------------------------------------- overlay */
/* Title bars FreeCAD draws for docks and overlay panels (Model, Tasks,
   Report). OverlayToolButtons are fixed 17 px squares; the generic
   QToolButton rule above gave them 4 px padding and a 1 px border, which
   left 7 px for the icon, so the title-bar controls read as specks (release
   PRD R88). Inside an overlay panel the overlay sheet (render_overlay)
   takes over; these rules cover docks that are not overlaid. */
Gui--OverlayTitleBar {
    background: #ffffff;
    color: #6b7280;
}

Gui--OverlayToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 0;
}

Gui--OverlayToolButton:hover {
    background: #f3f4f6;
    border-color: #e5e7eb;
}

Gui--OverlayToolButton:checked,
Gui--OverlayToolButton:pressed {
    background: #f3f4f6;
    border-color: #07805e;
}

/* Their icons. Upstream sets these in FreeCAD.qss, which this sheet
   replaces; without them the buttons keep their built-in glyphs, which are
   black: invisible on the dark title bar (MEASURED: Float button max luma
   0 on the dark theme, release PRD R118). Resting colour per mode, as for
   the overlay sheet's AtechOverlayIconColor token; hover takes the theme's
   full-contrast icon colour. */
Gui--OverlayToolButton[objectName="OBTN Float"] {
    image: url(qss:images_classic/float-lightgray.svg);
}

Gui--OverlayToolButton[objectName="OBTN Float"]:hover {
    image: url(qss:images_classic/float-black.svg);
}

Gui--OverlayToolButton[objectName="OBTN Overlay"] {
    image: url(qss:images_classic/overlay-lightgray.svg);
}

Gui--OverlayToolButton[objectName="OBTN Overlay"]:hover {
    image: url(qss:images_classic/overlay-black.svg);
}

/* ------------------------------------------------------- dialog buttons */
/* The Close button of a task dialog (Part_Primitives and every other
   QDialogButtonBox) takes Qt's stock SP_DialogCloseButton icon, a black X:
   MEASURED mean luma 21 on the dark theme's buttons, where every other
   stock dialog icon is coloured and reads (R118). Qt's stylesheet style
   substitutes this icon when the property is set. */
QDialogButtonBox {
    dialog-close-icon: url(qss:images_classic/close-black.svg);
}

/* ------------------------------------------------------------- progress */
QProgressBar {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 5px;
    text-align: center;
    color: #111827;
}

QProgressBar::chunk {
    background: #07805e;
    border-radius: 4px;
}
