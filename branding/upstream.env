# The upstream FreeCAD AppImage this distribution is built from. PINNED:
# build_appimage.sh refuses any input whose sha256 differs, and downloads the
# URL below when no local copy is given. Values checked 2026-09-25 against
# the GitHub release API (asset digest) and a local copy.
UPSTREAM_URL="https://github.com/FreeCAD/FreeCAD/releases/download/1.1.3/FreeCAD_1.1.3-Linux-x86_64-py311.AppImage"
UPSTREAM_SHA256="3a853eb69ee595f779f2255dbf80a765926981d8ff68903cefee4dfb03a8f5ef"
UPSTREAM_SIZE=820795896
FREECAD_TAG="1.1.3"
# git rev-parse 1.1.3 in https://github.com/FreeCAD/FreeCAD (lightweight tag).
# The binary's own "Revision: 20260725 (Git shallow)" is a build date, not this.
FREECAD_COMMIT="145529fe741292ff0b3977a01195bf0247425794"

# macOS (branding/build_macos.sh): the same FreeCAD 1.1.3 release, one DMG per
# architecture. Values from the GitHub release API asset digests, 2026-10-17;
# the arm64 one also checked against a local download. Inside each DMG,
# FreeCAD.app is signed "Developer ID Application: The FreeCAD project
# association (289DJRF23X)" and notarized (spctl: "Notarized Developer ID").
MACOS_ARM64_URL="https://github.com/FreeCAD/FreeCAD/releases/download/1.1.3/FreeCAD_1.1.3-macOS-arm64-py311.dmg"
MACOS_ARM64_SHA256="f5c0ece7cd7c932466d6effadc0fc6e179b0538a9d9a6a77a6769eae3af2667c"
MACOS_X86_64_URL="https://github.com/FreeCAD/FreeCAD/releases/download/1.1.3/FreeCAD_1.1.3-macOS-x86_64-py311.dmg"
MACOS_X86_64_SHA256="8434bd6ad32f597605d184e5b996f496e9cbc7e6d8ffb6db4dbd6e2ce6d1612b"
MACOS_UPSTREAM_TEAM_ID="289DJRF23X"
