+"""Request guard for the XML-RPC bridge: token, Origin, Content-Type, Host.
+
+Added by Atech (optional patch 0002, NOT applied by default). Without it,
+`execute_code` on 127.0.0.1 runs Python as the user for ANY local caller --
+including a web page: a browser may POST a `text/plain` body cross-origin
+without a CORS preflight, and SimpleXMLRPCRequestHandler parses it as XML-RPC.
+
+A request is served only when ALL of these hold:
+
+  * no `Origin` header           -- browsers always send one on a cross-site
+                                    POST; MCP clients (xmlrpc.client) never do
+  * `Content-Type: text/xml`     -- what xmlrpc.client sends; `text/plain`,
+                                    form and multipart bodies are refused
+  * `Host` names the loopback    -- defeats DNS rebinding (an attacker's name
+    address we listen on            resolving to 127.0.0.1 still carries the
+                                    attacker's name in Host)
+  * `X-FreeCAD-MCP-Token` equals -- a per-install random token stored 0600 in
+    the install token               the user data dir; a page cannot read it
+
+This module imports nothing from FreeCAD, so it is testable in plain Python.
+Client side: pass the header with
+    xmlrpc.client.ServerProxy(uri, headers=[(TOKEN_HEADER, token)])
+"""
+
+import hmac
+import os
+import secrets
+import stat
+from xmlrpc.server import SimpleXMLRPCRequestHandler
+
+TOKEN_FILENAME = "freecad_mcp_token"
+TOKEN_HEADER = "X-FreeCAD-MCP-Token"
+_LOOPBACK_NAMES = ("127.0.0.1", "localhost", "[::1]")
+
+
+def token_path(user_dir):
+    return os.path.join(user_dir, TOKEN_FILENAME)
+
+
+def load_or_create_token(user_dir):
+    """Return the install token, creating it (mode 0600) on first use.
+
+    Created with O_EXCL|O_NOFOLLOW so a pre-planted symlink is refused rather
+    than followed. An existing file with group/other bits is tightened to
+    0600 before it is trusted.
+    """
+    os.makedirs(user_dir, exist_ok=True)
+    path = token_path(user_dir)
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
+    try:
+        fd = os.open(path, flags, 0o600)
+    except FileExistsError:
+        st = os.lstat(path)
+        if not stat.S_ISREG(st.st_mode):
+            raise PermissionError("%s is not a regular file; refusing it" % path)
+        if st.st_mode & 0o077:
+            os.chmod(path, 0o600)
+        with open(path, "r", encoding="ascii") as fh:
+            tok = fh.read().strip()
+        if len(tok) < 32:
+            raise PermissionError("%s holds no usable token; delete it to "
+                                  "regenerate" % path)
+        return tok
+    tok = secrets.token_urlsafe(32)
+    with os.fdopen(fd, "w", encoding="ascii") as fh:
+        fh.write(tok + "\n")
+    return tok
+
+
+def allowed_hosts(port):
+    """Host header values accepted for a loopback-bound server."""
+    out = set()
+    for name in _LOOPBACK_NAMES:
+        out.add(name)
+        out.add("%s:%d" % (name, port))
+    return frozenset(out)
+
+
+def check_request(headers, token, hosts):
+    """None when the request may be served, else (http_status, reason).
+
+    `headers` is any mapping with a case-insensitive .get (email.message).
+    `hosts` is None to skip the Host check (remote access explicitly on).
+    """
+    if headers.get("Origin") is not None:
+        return 403, "requests carrying an Origin header are refused"
+    ctype = (headers.get("Content-Type") or "").split(";", 1)[0].strip().lower()
+    if ctype != "text/xml":
+        return 415, "Content-Type must be text/xml"
+    if hosts is not None:
+        host = (headers.get("Host") or "").strip().lower()
+        if host not in hosts:
+            return 403, "Host header does not name this server"
+    got = headers.get(TOKEN_HEADER) or ""
+    if not token or not hmac.compare_digest(got.encode(), token.encode()):
+        return 401, "missing or wrong %s" % TOKEN_HEADER
+    return None
+
+
+class GuardedRequestHandler(SimpleXMLRPCRequestHandler):
+    """SimpleXMLRPCRequestHandler that runs check_request() first.
+
+    The server object must carry `atech_token` and `atech_hosts`.
+    """
+
+    def do_POST(self):
+        verdict = check_request(self.headers,
+                                getattr(self.server, "atech_token", None),
+                                getattr(self.server, "atech_hosts", None))
+        if verdict is not None:
+            code, reason = verdict
+            self.close_connection = True
+            body = reason.encode("utf-8")
+            self.send_response(code)
+            self.send_header("Content-Type", "text/plain; charset=utf-8")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+            return
+        super().do_POST()
