+def _port_in_use(host, port, timeout=1.0):
+    """True if something is already LISTENing on host:port.
+
+    Asked by connecting, which is the question the kernel can actually
+    answer. Never shell out to `ss | grep <port>`: the port number also
+    appears in the Recv-Q/Send-Q columns, so a grep matches unrelated rows.
+    """
+    import socket as _socket
+
+    probe_host = "127.0.0.1" if host == "0.0.0.0" else host
+    sock = _socket.socket(_socket.AF_INET, _socket.SOCK_STREAM)
+    sock.settimeout(timeout)
+    try:
+        return sock.connect_ex((probe_host, port)) == 0
+    finally:
+        sock.close()
+
+
